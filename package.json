{
  "name": "support-desk",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/worker",
    "packages/shared",
    "packages/policy",
    "packages/db",
    "packages/storage"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.build.json",
    "build:web": "vite build apps/web",
    "start:api": "node dist/apps/api/src/index.js",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite apps/web",
    "lint": "eslint --max-warnings 0 apps packages scripts/dev.mjs",
    "format": "prettier --write apps packages",
    "format:check": "prettier --check apps packages",
    "test": "vitest run",
    "test:foundation": "node --test scripts/governance/check-foundation.test.mjs",
    "check:foundation": "node scripts/governance/check-foundation.mjs",
    "check:licenses": "license-checker --summary",
    "check:audit": "npm audit --audit-level=moderate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "license-checker": "^25.0.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "^11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "eslint": {
      "minimatch": "^11.0.1"
    }
  }
}
