{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node10",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": ["apps/api/**/*", "apps/worker/**/*", "packages/**/*"],
  "exclude": ["node_modules", "dist", "apps/web", "**/*.test.ts"]
}
